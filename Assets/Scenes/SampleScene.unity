  isCatQuestNPC: 0
  catNoCloverDialogue: []
  catTradeDialogue: []
  catCompletedDialogue: []
  cloverItemID: clover
  isBusTicketNPC: 1
  busTicketMissingDialogue:
  - (Kinjo can hear someone complaining about a lost bus ticket inside).
  busTicketReturnDialogue:
  - What? Who is it? Oh a dog! you found my ticket! Thank you so much! Have some
    food!
  - (Kinjo quickly eats the food and notices the person drop a gold coin, he takes
    it after the man goes back).
  busTicketCompletedDialogue:
  - (Kinjo hears the sound of someone packing their things).
