  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34ad14eea1b485b409b513ff261f5430, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogueData: {fileID: 11400000, guid: e72773e271b957f49a64e664c721fb7b, type: 2}
  dialoguePanel: {fileID: 509023293}
  dialogueText: {fileID: 1423121925}
  nameText: {fileID: 1272133819}
  portraitImage: {fileID: 1289033131}
  isCrowQuestNPC: 1
  noCoinsDialogue:
  - 'Hello Kinjo! Why the long face?  '
  - ...
  - Your owner is bankrupt!?
  - So he needs money, well lucky for you, I know about a treasure chest somewhere
    around here.
  - Ooh.. So you want to learn about the treasure, huh?
  - I may be able to help you, if you bring me three gold coins!
  someCoinsDialogue: []
  rewardDialogue:
  - Wow! You managed to actually find three gold coins!
  - 'Alright then, I don''t know where the treasure is exactly, but I do have this
    key for the treasure chest! '
  - I heard you needed to dig somewhere but I don't know where. And I can't dig anything
    myself.
  alreadyRewardedDialogue:
  - Good luck... (sucker).
  isCatQuestNPC: 0
  catNoCloverDialogue: []
  catTradeDialogue: []
  catCompletedDialogue: []
  cloverItemID: clover
  isBusTicketNPC: 0
  busTicketMissingDialogue: []
  busTicketReturnDialogue: []
  busTicketCompletedDialogue: []
  busTicketItemID: BusTicket
  keyItemID: GoldenKey
  keyItemName: Golden Key
  keyItemIcon: {fileID: -785641940956926436, guid: ce935ffc755ec5149ae38bffa78af73b, type: 3}
